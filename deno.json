    "prune-docker": "deno run --allow-run scripts/prune_docker.ts",
    "update-all": "deno run --allow-run --allow-env --allow-read scripts/update_all.ts",
    "update-package": "deno run --allow-run --allow-env --allow-read scripts/update_package.ts",
    "update-mise": "deno run --allow-run scripts/update_mise.ts",
